{
  "name": "nsw-question-bank",
  "compatibility_date": "2024-10-13",
  "pages_build_output_dir": "./",
  "assets": {
    "directory": "./",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nsw-question-bank-db",
      "database_id": "0f3018c9-35b4-4f3e-be08-6dbad6dbf1ef"
    }
  ],
  "r2_buckets": [
    {
      "binding": "WORKSHEETS_BUCKET",
      "bucket_name": "nsw-worksheets"
    }
  ]
}